JINA_READER_TIMEOUT=6
# 消费方：backend/tools/wayback.py
WAYBACK_TIMEOUT=6
# 消费方：backend/graph/adapters/collector_adapter.py（legacy）
COLLECTOR_TIMEOUT_SECONDS=180
# 消费方：backend/graph/adapters/collector_adapter.py（legacy）
COLLECTOR_REPORT_TIMEOUT_SECONDS=300
# 消费方：backend/api/app_factory.py
RAG_PROBE_FAILURE_TTL_SECONDS=45
# 消费方：backend/api/app_factory.py、backend/rag/hybrid_service.py
RAG_V2_VECTOR_DIM=1024
# 消费方：backend/rag/hybrid_service.py
RAG_V2_RRF_K=60
# 消费方：backend/rag/execution_pipeline.py
RAG_V2_TOP_K=18
# 消费方：backend/rag/execution_pipeline.py
RAG_V2_RERANK_TOP_N=8
# 消费方：backend/rag/ingestion.py
RAG_V2_NEWS_TTL_HOURS=168
# 消费方：backend/rag/ingestion.py
RAG_V2_EPHEMERAL_TTL_HOURS=12

# ── Embedding & Reranker ─────────────────────────────────────────────────────
# 消费方：backend/api/app_factory.py、backend/rag/embedder.py 等
RAG_EMBEDDING=lexical
# 消费方：backend/rag/embedder.py
BGE_M3_DEVICE=cpu
# 消费方：backend/rag/embedder.py
BGE_M3_MAX_LENGTH=512
# 消费方：backend/rag/embedder.py
RAG_HASH_DIM=1024
# 消费方：backend/rag/embedder.py、backend/rag/reranker.py
RAG_WORKER_TIMEOUT_SECONDS=60
# 消费方：backend/api/app_factory.py、backend/rag/reranker.py 等
RAG_RERANKER=none
# 消费方：backend/rag/reranker.py
RAG_RERANKER_MAX_LENGTH=512
# 消费方：backend/services/prediction_runner.py
PREDICTION_DAILY_ATTEMPTS=60
# 消费方：backend/services/prediction_runner.py
PREDICTION_OUTPUT_TOKENS=4096
# 消费方：scripts/prediction_watchdog.py
PREDICTION_ALERT_EMAIL=

