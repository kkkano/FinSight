FINSIGHT_AGENT_CONTEXT_WINDOW=131072
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_MAX_OUTPUT_TOKENS=16384
# 消费方：backend/agent_runtime/loop.py、backend/config/settings.py
FINSIGHT_AGENT_MAX_TURNS=12
# 消费方：backend/agent_runtime/loop.py、backend/config/settings.py
FINSIGHT_AGENT_TOKEN_BUDGET=160000
