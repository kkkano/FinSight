# 消费方：backend/rag/api_provider.py / reranker.py
RAG_RERANK_TIMEOUT_SECONDS=15
# 消费方：backend/config/settings.py
FINSIGHT_RUN_TIMEOUT_SECONDS=300
# 消费方：backend/config/settings.py
FINSIGHT_RUN_TIMEOUT_REPORT_SECONDS=600
# 消费方：backend/config/settings.py
FINSIGHT_RUN_TIMEOUT_BRIEF_SECONDS=300
# 消费方：backend/config/settings.py
FINSIGHT_EXECUTE_LIVE_TOOLS=true
# 消费方：backend/config/settings.py
FINSIGHT_EXECUTION_PROGRESS_HEARTBEAT_SECONDS=2.5
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_INVOKER_TIMEOUT_SECONDS=180
# 消费方：backend/config/settings.py
FINSIGHT_DEEP_SEARCH_AGENT_TIMEOUT_SECONDS=1000
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_INVOKER_RETRY_ATTEMPTS=2

# ── limits｜并发、用量与资源 ──

# 消费方：backend/services/llm_retry.py
LLM_RATE_LIMIT_RETRY_ENABLED=true
# 消费方：backend/services/llm_retry.py
LLM_RATE_LIMIT_RETRY_MAX_ATTEMPTS=3
# 消费方：backend/services/llm_retry.py
LLM_RATE_LIMIT_RETRY_SLEEP_SECONDS=1
# 消费方：backend/services/llm_retry.py
LLM_RATE_LIMIT_RETRY_JITTER_SECONDS=0.2
# 消费方：backend/services/llm_retry.py
LLM_RATE_LIMIT_RETRY_ACQUIRE_TIMEOUT_SECONDS=15
# 消费方：docker-compose.yml / Dockerfile 构建或部署
RAG_WORKER_MEMORY_LIMIT=3000m
# 消费方：docker-compose.yml / Dockerfile 构建或部署
RAG_WORKER_MEMORY_SWAP_LIMIT=3600m
# 消费方：backend/rag/worker.py
RAG_WORKER_MIN_AVAILABLE_MB=2400
# 消费方：docker-compose.yml / Dockerfile 构建或部署
RAG_WORKER_CPUS=1.0

# HTTP abuse protection is mandatory in production. The readiness endpoint
# refuses to become ready if this is disabled.
# 消费方：backend/config/settings.py
RATE_LIMIT_ENABLED=true
# 消费方：backend/config/settings.py
RATE_LIMIT_PER_MINUTE=300
# 消费方：backend/config/settings.py
RATE_LIMIT_WINDOW_SECONDS=60
# 本部署关闭整轮生成请求的并发上限；不影响 HTTP 频率或供应商限流。
# 消费方：backend/config/settings.py
CONCURRENCY_LIMIT_ENABLED=false
# 消费方：backend/config/settings.py
GENERATION_MAX_CONCURRENT=10
# 消费方：backend/config/settings.py
GENERATION_MAX_CONCURRENT_PER_CLIENT=2

# 每个用户的 UTC 自然日 LLM 成本上限（USD）；0 或负数关闭，admin 用户豁免。
# 消费方：backend/services/llm_usage_store.py
USER_DAILY_COST_LIMIT_USD=0
# 消费方：backend/agent_runtime/service.py、backend/config/settings.py
FINSIGHT_AGENT_MAX_ACTIVE_RUNS=2
# Reserve separate capacity for the unchanged scheduled forecast worker.
# 消费方：backend/agent_runtime/loop.py、backend/agent_runtime/service.py 等
FINSIGHT_AGENT_MODEL_CONCURRENCY=2
# Local workload guards; use actual provider/account limits at deployment.
# 消费方：backend/agent_runtime/loop.py、backend/config/settings.py
FINSIGHT_AGENT_RPM_LIMIT=30
# 消费方：backend/agent_runtime/loop.py、backend/config/settings.py
FINSIGHT_AGENT_MIN_REQUEST_INTERVAL_SECONDS=10
# 消费方：backend/agent_runtime/loop.py、backend/config/settings.py
FINSIGHT_AGENT_TPM_LIMIT=250000
# 消费方：backend/agent_runtime/data.py、backend/config/settings.py
FINSIGHT_ARTIFACT_CACHE_MAX_MB=512
# 容器上限不预占内存；按实际主机容量调节。
# 消费方：docker-compose.yml / Dockerfile 构建或部署
BACKEND_MEMORY_LIMIT=768m
# 消费方：docker-compose.yml / Dockerfile 构建或部署
BACKEND_MEMORY_SWAP_LIMIT=1024m
# 消费方：docker-compose.yml / Dockerfile 构建或部署
BACKEND_CPUS=1.0

# ── providers｜模型、行情与外部服务 ──

# Docker Compose 会根据以上三项生成；非 Compose 部署必须显式设置同一 DSN。
# FINSIGHT_POSTGRES_DSN=postgresql+psycopg://finsight:pass@postgres:5432/finsight

# ── LLM (OpenAI-compatible API) ──────────────────────────────────────────────
# Endpoint, model, and key are all required. Never commit real credentials.
# 消费方：backend/config/settings.py、backend/llm_config.py
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_key_here
# 消费方：backend/config/settings.py、backend/llm_config.py
OPENAI_COMPATIBLE_API_BASE=https://your-llm-endpoint/v1
# 消费方：backend/config/settings.py、backend/llm_config.py
OPENAI_COMPATIBLE_MODEL=your-model-name
# 配置 STEPFUN_API_KEY 后，Step 5 Preview 是实际系统默认模型。
# 兼容代理只在没有 Step 凭据时作为默认；每次用户任务锁定开始时的模型。
# failure_domain 默认取规范化 API hostname。高可用要求 secondary 使用独立 hostname/故障域。
# Secondary endpoint (disabled by default): uncomment all three lines to enable.
# GEMINI_PROXY_API_KEY=your_secondary_key_here
# GEMINI_PROXY_API_BASE=https://your-independent-secondary-endpoint/v1
# GEMINI_PROXY_MODEL=your-secondary-model-name
# 若兼容代理运行在同一台 Linux 宿主机的 80 端口，使用：
# OPENAI_COMPATIBLE_API_BASE=http://host.docker.internal/v1

# ── Proxy isolation ──────────────────────────────────────────────────────────
# Only yfinance uses YFINANCE_PROXY and only search uses SEARCH_PROXY. Neither
# value is mapped to process-wide HTTP_PROXY or HTTPS_PROXY.
# 消费方：backend/tools/env.py、backend/tools/yfinance_client.py
YFINANCE_PROXY=
# 消费方：backend/agent_runtime/adapters/sources.py、backend/tools/search.py
SEARCH_PROXY=
# 消费方：requests/httpx等HTTP客户端环境代理解析（仅排除列表）
NO_PROXY=host.docker.internal,localhost,127.0.0.1
# 消费方：requests/httpx等HTTP客户端环境代理解析（仅排除列表）
no_proxy=host.docker.internal,localhost,127.0.0.1

# ── Build network mirrors ───────────────────────────────────────────────────
# Used only during Docker image build; override if your server has faster PyPI access.
# 消费方：docker-compose.yml / Dockerfile 构建或部署
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

