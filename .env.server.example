EVAL_LLM_MODEL=deepseek-ai/DeepSeek-V3

# 用户模型选择与固定 US20 预测账本（真实密钥不入库）
# 消费方：backend/config/settings.py、backend/llm_config.py 等
STEPFUN_API_KEY=
# 消费方：scripts/prediction_watchdog.py
SMTP_SERVER=
# 消费方：scripts/prediction_watchdog.py
SMTP_PORT=587
# 消费方：scripts/prediction_watchdog.py
SMTP_USER=
# 消费方：scripts/prediction_watchdog.py
EMAIL_FROM=
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_API_BASE=https://apikl.ai/v1
# 消费方：backend/config/settings.py、backend/services/model_selection.py
FINSIGHT_AGENT_MODEL=gpt-6.1-terra
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_API_KEY=
# 研究界面的 Step 5 按量 API 选项；不参与 US20 默认模型配置。
FINSIGHT_AGENT_STEPFUN_API_KEY=
# 研究界面的 qwen3.8-flash 选项（https://api.kunyou.asia/v1），不参与 US20 默认模型配置。
FINSIGHT_AGENT_QWEN_API_KEY=
# 后端独立发布标签；留空时沿用 IMAGE_TAG。
BACKEND_IMAGE_TAG=
# 仅 tests/agent_eval/run.py --provider fallback 显式选用，不改变生产或预测模型。
FINSIGHT_EVAL_FALLBACK_API_BASE=https://api.kunyou.asia/v1
FINSIGHT_EVAL_FALLBACK_MODEL=qwen3.8-flash
FINSIGHT_EVAL_FALLBACK_API_KEY=
# 官方能力值；中转的完整上限尚未实测，基线命令可显式覆盖预算。
FINSIGHT_EVAL_FALLBACK_CONTEXT_WINDOW=1000000
FINSIGHT_EVAL_FALLBACK_MAX_OUTPUT=16384
# 额外评测端点；仅 --provider moxuna 显式选择，密钥通过私有配置提供。
FINSIGHT_EVAL_MOXUNA_API_BASE=https://jpn.cdn.moxuna.com/v1
FINSIGHT_EVAL_MOXUNA_MODEL=deepseek-v4.1-flash
FINSIGHT_EVAL_MOXUNA_API_KEY=
# Vectide 评测端点；仅 --provider vectide 显式选择，密钥保存在私有配置。
FINSIGHT_EVAL_VECTIDE_API_BASE=https://vectide.cn/v1
FINSIGHT_EVAL_VECTIDE_MODEL=deepseek-v4.1-flash-1017
FINSIGHT_EVAL_VECTIDE_API_KEY=
FINSIGHT_EVAL_VECTIDE_CONTEXT_WINDOW=1048576
FINSIGHT_EVAL_VECTIDE_MAX_OUTPUT=16384
# APIKL：用户指定的 gpt-6.1-terra；/keys 是控制台，不是 API 地址。
# 仅 --provider apikl 显式选择，key 只在私密配置；预算不是供应商最大规格。
FINSIGHT_EVAL_APIKL_API_BASE=https://apikl.ai/v1
FINSIGHT_EVAL_APIKL_MODEL=gpt-6.1-terra
FINSIGHT_EVAL_APIKL_API_KEY=
FINSIGHT_EVAL_APIKL_CONTEXT_WINDOW=131072
FINSIGHT_EVAL_APIKL_MAX_OUTPUT=16384
# 仅评测进程映射到计算服务配置；两项必须同时填写，不改变产品默认。
FINSIGHT_EVAL_ANALYSIS_WORKER_URL=
FINSIGHT_EVAL_ANALYSIS_WORKER_TOKEN=
# 消费方：backend/agent_runtime/analysis.py、backend/config/settings.py
FINSIGHT_ANALYSIS_WORKER_URL=
# 消费方：backend/agent_runtime/analysis.py、backend/analysis_worker/dispatcher.py 等
FINSIGHT_ANALYSIS_WORKER_TOKEN=

# Optional hosted semantic retrieval. SiliconFlow lists BAAI/bge-m3 as free;
# it still requires a separate provider API key. No local weights are downloaded.
# 消费方：backend/api/app_factory.py、backend/rag/api_provider.py
RAG_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# 消费方：backend/api/app_factory.py、backend/config/settings.py 等
RAG_EMBEDDING_API_KEY=
# 消费方：backend/rag/api_provider.py
RAG_RERANK_API_URL=
# 消费方：backend/config/settings.py、backend/rag/api_provider.py
RAG_RERANK_API_KEY=

# ── storage｜数据库、账本与产物路径 ──


# ── PostgreSQL (docker-compose managed) ─────────────────────────────────────
# 消费方：docker-compose.yml / Dockerfile 构建或部署
POSTGRES_DB=finsight
# 消费方：docker-compose.yml / Dockerfile 构建或部署
POSTGRES_USER=finsight
# 消费方：docker-compose.yml / Dockerfile 构建或部署
POSTGRES_PASSWORD=your_strong_password_here

# ── LangGraph ────────────────────────────────────────────────────────────────
# 消费方：backend/graph/checkpointer.py
LANGGRAPH_CHECKPOINTER_BACKEND=postgres
# 消费方：backend/config/settings.py、backend/services/prediction_store.py
FINSIGHT_CONFIG_DIR=
# 消费方：backend/agent_runtime/limits.py、backend/config/settings.py
FINSIGHT_RUNTIME_QUOTA_DB=
# 消费方：backend/agent_runtime/actions.py、backend/config/settings.py
FINSIGHT_ACTION_STORE=
# 消费方：backend/agent_runtime/data.py、backend/config/settings.py
FINSIGHT_ARTIFACT_DIR=

# ── features｜功能开关 ──

# 消费方：backend/config/settings.py、backend/services/startup_check.py
FINSIGHT_LLM_REQUIRED=true
# 消费方：backend/api/security_gate.py、backend/config/settings.py
ALLOW_ANONYMOUS_GENERATION=false
# 消费方：backend/llm_config.py
ENABLE_LANGSMITH=true

# ── LangFuse (optional, observability) ──────────────────────────────────────
# 消费方：backend/services/langfuse_tracer.py
LANGFUSE_ENABLED=true

# ── 证据研究与协议适配器 ────────────────────────────────────────────────────
# 消费方：backend/config/settings.py
RESEARCH_LEDGER_ENABLED=true
# 消费方：backend/graph/nodes/synthesize.py
QUERY_COVERAGE_ENABLED=true
# 消费方：backend/graph/planning/util.py
SEC_HOLDINGS_ENABLED=true
# 协议适配器默认关闭，只暴露只读工具
# 消费方：backend/protocols/mcp_server.py
MCP_SERVER_ENABLED=false
# 消费方：backend/protocols/a2a_server.py
A2A_SERVER_ENABLED=false

# ── Prediction 与 Monitor ───────────────────────────────────────────────────
# Dashboard 显式创建异步 Prediction；旧 Agent 完成后不再隐式追加 LLM 调用。
# 消费方：backend/api/lifespan.py、backend/api/system_router.py 等
PREDICTION_GENERATION_ENABLED=true
# 消费方：backend/api/lifespan.py、backend/config/settings.py
PREDICTION_OUTCOME_SCHEDULER_ENABLED=true
# 仅当前 Dashboard 标的的页面 lease 监控；无有效 lease 时不会请求行情或 LLM。
# 消费方：backend/api/lifespan.py、backend/api/system_router.py 等
MONITOR_REALTIME_ENABLED=true

# ── RAG V2 (Postgres pgvector — docker-compose overrides DSN automatically) ──
# These two are set in docker-compose.yml via environment: section.
# Do NOT override here unless you want a separate external postgres.
# RAG_V2_BACKEND=postgres
# RAG_V2_POSTGRES_DSN=postgresql+asyncpg://finsight:pass@postgres:5432/finsight

# 消费方：backend/rag/hybrid_service.py
RAG_V2_ALLOW_MEMORY_FALLBACK=false
# 消费方：backend/api/system_router.py、backend/config/settings.py 等
PREDICTION_ENABLED=false
# Enable only after checking image input on this exact model/endpoint.
# 消费方：backend/config/settings.py、backend/services/model_selection.py
FINSIGHT_AGENT_VISION=false
# 显式启动时做一次托管向量/重排小探针；health轮询不调用云模型。
# 消费方：backend/api/lifespan.py
RAG_STARTUP_VERIFY=false

# ── auth｜认证、公开路径与CORS ──


# Supabase Auth (shared by frontend build + backend runtime verification)
# Recommended: keep SUPABASE_* and VITE_SUPABASE_* pointing to the same project.
# Example:
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 消费方：backend/config/settings.py、backend/security/supabase_auth.py
SUPABASE_URL=
# 公开白名单只保留健康检查和共享报告读取；OpenAPI 文档不默认公开。
# 消费方：backend/config/settings.py
API_PUBLIC_PATHS=/health,/livez,/readyz,/api/reports/shared/*
# 只允许 GET/HEAD；Chat、History、Watchlist、Prediction、Monitor 永不进入此白名单。
# 消费方：backend/config/settings.py
API_PUBLIC_READ_PATHS=/api/stock/price/*,/api/stock/news/*,/api/stock/kline/*,/api/dashboard/*
# 生产必须为 true。若 Supabase 配置不完整，应用启动失败而不是退化为 public 用户。
# 消费方：backend/config/settings.py
SUPABASE_AUTH_REQUIRED=true
# legacy HS256 项目填写；留空时后端通过 SUPABASE_URL 自动读取 RS256/ES256 JWKS。
# 消费方：backend/api/security_gate.py、backend/config/settings.py 等
SUPABASE_JWT_SECRET=
# 消费方：backend/config/settings.py
SUPABASE_PUBLISHABLE_KEY=
# 消费方：backend/config/settings.py
VITE_SUPABASE_URL=
# 消费方：backend/config/settings.py
VITE_SUPABASE_PUBLISHABLE_KEY=
# 消费方：scripts/prediction_watchdog.py
SMTP_PASSWORD=
# OAuth provider未配置时不展示GitHub按钮。
# 消费方：frontend/src / Vite 构建
VITE_GITHUB_AUTH_ENABLED=false
