# FinSight 本地开发环境模板
# 复制为 .env 后填写；不得提交真实密钥、密码或生产连接串。

APP_MODE=development
LOG_LEVEL=INFO

# LLM：ResearchAnalyst 与 PredictionAnalyst 共用 OpenAI-compatible 配置。
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=https://your-llm-endpoint/v1
OPENAI_COMPATIBLE_MODEL=your-model-name

# 可选独立故障域的第二端点；三项必须同时配置。
GEMINI_PROXY_API_KEY=
GEMINI_PROXY_API_BASE=
GEMINI_PROXY_MODEL=

# 本地代理只作用于指定客户端，不设置进程级 HTTP_PROXY/HTTPS_PROXY。
YFINANCE_PROXY=
SEARCH_PROXY=
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# 核心 PostgreSQL。留空时仅允许 development 的无数据库路径。
FINSIGHT_POSTGRES_DSN=
LANGGRAPH_CHECKPOINTER_BACKEND=memory
LANGGRAPH_CHECKPOINT_POSTGRES_DSN=

# 行情、财务与宏观供应商。
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=
TIINGO_API_KEY=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
OPENFIGI_API_KEY=
SEC_USER_AGENT=FinSight developer@example.com

# 每种 capability 最多 primary + secondary；degraded 来源不能用于 Prediction/Outcome。
MARKET_KLINE_PRIMARY_PROVIDER=twelve_data
MARKET_KLINE_SECONDARY_PROVIDER=stooq
MARKET_KLINE_TRUSTED_PROVIDERS=twelve_data
MARKET_KLINE_CACHE_TTL_SECONDS=60
MARKET_QUOTE_PRIMARY_PROVIDER=twelve_data
MARKET_QUOTE_SECONDARY_PROVIDER=stooq
MARKET_QUOTE_TRUSTED_PROVIDERS=twelve_data
MARKET_QUOTE_CACHE_TTL_SECONDS=30
MARKET_NEWS_PRIMARY_PROVIDER=finnhub
MARKET_NEWS_SECONDARY_PROVIDER=yfinance
MARKET_NEWS_TRUSTED_PROVIDERS=finnhub
MARKET_NEWS_CACHE_TTL_SECONDS=300
MARKET_FINANCIAL_PRIMARY_PROVIDER=yfinance
MARKET_FINANCIAL_SECONDARY_PROVIDER=sec_companyfacts
MARKET_FINANCIAL_TRUSTED_PROVIDERS=sec_companyfacts
MARKET_FINANCIAL_CACHE_TTL_SECONDS=3600

# 搜索与证据增强。
TAVILY_API_KEY=
EXA_API_KEY=
DEEPSEARCH_ENABLE_JINA_FALLBACK=true
DEEPSEARCH_ENABLE_WAYBACK_FALLBACK=true
DEEPSEARCH_HTTP_RETRIES=0
DEEPSEARCH_FETCH_TIMEOUT_SECONDS=10
JINA_READER_TIMEOUT=6
WAYBACK_TIMEOUT=6

# 六节点 Graph：router/planner/collector 均为确定性；只在 analyze 调用业务 LLM。
FINSIGHT_FINANCIAL_TERM_RESOLVER=on
FINSIGHT_INTENT_CONTRACT_MODE=enforce
FINSIGHT_STRUCTURED_SYNTHESIS=on
FINSIGHT_CHAT_MULTI_TICKER_RESEARCH_LIMIT=3
LANGGRAPH_EXECUTE_LIVE_TOOLS=false
LANGGRAPH_SYNTHESIZE_MODE=llm
LANGGRAPH_SYNTHESIZE_TIMEOUT_SEC=150
LANGGRAPH_SYNTHESIZE_MAX_TOKENS=3000
LANGGRAPH_SYNTHESIZE_MAX_ATTEMPTS=2
LANGGRAPH_SYNTHESIZE_ACQUIRE_TIMEOUT_SEC=120
LANGGRAPH_SYNTHESIZE_REPORT_TIMEOUT_SEC=800
LANGGRAPH_SYNTHESIZE_REPORT_MAX_TOKENS=6000
LANGGRAPH_SYNTHESIZE_REPORT_MAX_ATTEMPTS=3
LANGGRAPH_SYNTHESIZE_REPORT_ACQUIRE_TIMEOUT_SEC=180
LANGGRAPH_REPORT_MAX_AGENTS=6
LANGGRAPH_REPORT_MIN_AGENTS=2
LANGGRAPH_ESCALATION_MIN_CONFIDENCE=0.85

# Evidence collector 合同。
RESEARCH_LEDGER_ENABLED=true
QUERY_COVERAGE_ENABLED=true
SEC_HOLDINGS_ENABLED=true

# Prediction 与页面 lease Monitor；无 PostgreSQL 时保持关闭。
PREDICTION_GENERATION_ENABLED=false
PREDICTION_PROMPT_VERSION=prediction-analyst-v1
PREDICTION_RUN_TIMEOUT_SECONDS=75
PREDICTION_LLM_ATTEMPT_TIMEOUT_SECONDS=30
PREDICTION_NEWS_TIMEOUT_SECONDS=5
PREDICTION_MAX_CONCURRENT_RUNS=2
PREDICTION_LLM_ENDPOINT_NAMES=openai-compatible-primary
PREDICTION_LLM_MAX_TOKENS=1600
PREDICTION_OUTCOME_SCHEDULER_ENABLED=false
PREDICTION_OUTCOME_INTERVAL_MINUTES=1440
MONITOR_REALTIME_ENABLED=false
MONITOR_PREDICTION_COOLDOWN_SECONDS=1800

# LLM 端点重试与预算。
LLM_ENDPOINT_DEFAULT_COOLDOWN_SEC=30
LLM_RATE_LIMIT_RETRY_ENABLED=true
LLM_RATE_LIMIT_RETRY_MAX_ATTEMPTS=3
LLM_RATE_LIMIT_RETRY_SLEEP_SECONDS=1
LLM_RATE_LIMIT_RETRY_JITTER_SECONDS=0.2
LLM_RATE_LIMIT_RETRY_ACQUIRE_TIMEOUT_SECONDS=15
USER_DAILY_COST_LIMIT_USD=0

# RAG：本地可显式回退内存；生产模板和 Compose 均禁止静默回退。
RAG_V2_BACKEND=auto
RAG_V2_ALLOW_MEMORY_FALLBACK=true
RAG_V2_POSTGRES_DSN=
RAG_V2_VECTOR_DIM=1024
RAG_V2_RRF_K=60
RAG_V2_TOP_K=18
RAG_V2_RERANK_TOP_N=8
RAG_V2_NEWS_TTL_HOURS=168
RAG_V2_EPHEMERAL_TTL_HOURS=12
RAG_EMBEDDING=bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_MAX_LENGTH=512
RAG_RERANKER=bge-reranker
RAG_RERANKER_MAX_LENGTH=512

# 认证与公开只读路径。production 必须 SUPABASE_AUTH_REQUIRED=true。
SUPABASE_AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
API_PUBLIC_PATHS=/health,/api/reports/shared/*
API_PUBLIC_READ_PATHS=/api/stock/price/*,/api/stock/news/*,/api/stock/kline/*,/api/dashboard/*
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

# 前端公开配置。
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 可观测性与默认关闭的协议适配器。
LANGSMITH_API_KEY=
ENABLE_LANGSMITH=false
LANGSMITH_PROJECT=FinSight
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MCP_SERVER_ENABLED=false
A2A_SERVER_ENABLED=false
A2A_PUBLIC_URL=
