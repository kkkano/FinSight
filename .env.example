COLLECTOR_TIMEOUT_SECONDS=180
# 消费方：backend/graph/adapters/collector_adapter.py（legacy）
COLLECTOR_REPORT_TIMEOUT_SECONDS=300

# Autonomous research runtime (public US20 forecast configuration remains separate)
# 消费方：backend/agent_runtime/config.py、backend/api/lifespan.py 等
# DeepSeek-V4.1-Flash-1017 官方窗口 1M；输出按研究预算预留 16K（官方上限 384K）。
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_CONTEXT_WINDOW=131072
# 消费方：backend/config/settings.py
FINSIGHT_AGENT_MAX_OUTPUT_TOKENS=16384
