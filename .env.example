# FinSight 本地开发配置模板（不包含真实凭据）
# typed事实源：backend/config/settings.py；原生研究bootstrap仅显式读取安全的私有配置。
# 新FINSIGHT_RUN_*预算优先；LANGGRAPH旧名仅兼容/冻结运行时读取，迁移期不要删除。
# 未填写模型三元组时请整体留空；填写时model/api_base/api_key必须齐备。
# 空存储路径使用既有默认值，不修改US20账本格式、模型、cutoff或策略。

# ── runtime｜运行时与预算 ──

# FinSight 本地开发环境模板
# 复制为 .env 后填写；不得提交真实密钥、密码或生产连接串。

# 消费方：backend/api/app_factory.py、backend/api/security_gate.py 等
APP_MODE=development
# 消费方：backend/api/app_factory.py、backend/api/security_gate.py 等
FINSIGHT_RUNTIME_PROFILE=development
# 消费方：历史保留键；当前生产Python代码未确认直接消费
LOG_LEVEL=INFO
# 消费方：backend/agents/deep_search_agent.py
DEEPSEARCH_ENABLE_JINA_FALLBACK=true
# 消费方：backend/agents/deep_search_agent.py
DEEPSEARCH_ENABLE_WAYBACK_FALLBACK=true
# 消费方：backend/agents/deep_search_agent.py
DEEPSEARCH_HTTP_RETRIES=0
# 消费方：backend/agents/deep_search_agent.py
DEEPSEARCH_FETCH_TIMEOUT_SECONDS=10
# 消费方：backend/tools/jina_reader.py
JINA_READER_TIMEOUT=6
# 消费方：backend/tools/wayback.py
WAYBACK_TIMEOUT=6

# 六节点 Graph：router/planner/collector 均为确定性；只在 analyze 调用业务 LLM。
# 消费方：历史兼容键；当前仅旧回归测试引用，生产消费者待清理
FINSIGHT_FINANCIAL_TERM_RESOLVER=on
# 消费方：backend/graph/intent_contract.py
FINSIGHT_INTENT_CONTRACT_MODE=enforce
# 消费方：backend/graph/nodes/synthesize.py
FINSIGHT_STRUCTURED_SYNTHESIS=on
# 消费方：backend/graph/intent_contract.py、backend/graph/understanding_v2.py
FINSIGHT_CHAT_MULTI_TICKER_RESEARCH_LIMIT=3
# 消费方：backend/api/system_router.py、backend/config/settings.py 等
LANGGRAPH_EXECUTE_LIVE_TOOLS=false
# 消费方：backend/api/system_router.py、backend/graph/nodes/synthesize.py 等
LANGGRAPH_SYNTHESIZE_MODE=llm
# 消费方：backend/llm_config.py
LLM_MAX_TOKENS=65536
# 消费方：backend/llm_config.py
LLM_FOREGROUND_MAX_TOKENS=65536
# 消费方：backend/graph/synthesis/research_synthesis.py、backend/llm_config.py 等
LLM_REQUEST_TIMEOUT_SECONDS=1200
# 消费方：backend/services/llm_usage.py
LLM_REQUEST_TOKEN_BUDGET=0
# 消费方：backend/config/settings.py
LANGGRAPH_EXECUTION_TIMEOUT_SECONDS=180
# 消费方：backend/config/settings.py
LANGGRAPH_EXECUTION_TIMEOUT_REPORT_SECONDS=300
# 消费方：backend/graph/nodes/analyze.py、backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_TIMEOUT_SEC=1200
# 消费方：backend/graph/nodes/analyze.py、backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_MAX_TOKENS=65536
# 消费方：backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_MAX_ATTEMPTS=2
# 消费方：backend/graph/nodes/analyze.py、backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_ACQUIRE_TIMEOUT_SEC=120
# 消费方：backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_REPORT_TIMEOUT_SEC=1200
# 消费方：backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_REPORT_MAX_TOKENS=65536
# 消费方：backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_REPORT_MAX_ATTEMPTS=1
# 消费方：backend/graph/nodes/synthesize.py
LANGGRAPH_SYNTHESIZE_REPORT_ACQUIRE_TIMEOUT_SEC=120
# 消费方：backend/graph/synthesis/research_synthesis.py
LANGGRAPH_STRUCTURED_SYNTHESIS_MAX_TOKENS=65536
# 消费方：backend/graph/synthesis/research_synthesis.py
LANGGRAPH_STRUCTURED_SYNTHESIS_REQUEST_TIMEOUT_SECONDS=1200
# 消费方：backend/graph/synthesis/research_synthesis.py
LANGGRAPH_STRUCTURED_SYNTHESIS_ACQUIRE_TIMEOUT_SECONDS=120
# 消费方：backend/graph/nodes/policy_gate.py、backend/graph/planning/policy_enforcement.py 等
LANGGRAPH_REPORT_MAX_AGENTS=6
# 消费方：backend/graph/nodes/policy_gate.py、backend/graph/planning/policy_enforcement.py 等
LANGGRAPH_REPORT_MIN_AGENTS=2
# 消费方：backend/graph/planning/policy_enforcement.py
LANGGRAPH_ESCALATION_MIN_CONFIDENCE=0.85
# 消费方：backend/services/prediction_service.py
PREDICTION_PROMPT_VERSION=prediction-analyst-v1
