# it still requires a separate provider API key. No local weights are downloaded.
# 消费方：backend/api/app_factory.py、backend/rag/api_provider.py
RAG_EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
# 消费方：backend/api/app_factory.py、backend/config/settings.py 等
RAG_EMBEDDING_API_KEY=
# 消费方：backend/rag/api_provider.py
RAG_RERANK_API_URL=
# 消费方：backend/config/settings.py、backend/rag/api_provider.py
RAG_RERANK_API_KEY=

# ── storage｜数据库、账本与产物路径 ──


# 核心 PostgreSQL。留空时仅允许 development 的无数据库路径。
# 消费方：backend/config/settings.py
FINSIGHT_POSTGRES_DSN=
# 消费方：backend/graph/checkpointer.py
LANGGRAPH_CHECKPOINTER_BACKEND=memory
# 消费方：backend/config/settings.py、backend/graph/checkpointer.py 等
LANGGRAPH_CHECKPOINT_POSTGRES_DSN=

# RAG：本地可显式回退内存；生产模板和 Compose 均禁止静默回退。
# 消费方：backend/api/app_factory.py、backend/rag/execution_pipeline.py 等
RAG_V2_BACKEND=auto
# 消费方：backend/config/settings.py、backend/rag/hybrid_service.py 等
RAG_V2_POSTGRES_DSN=
# 消费方：backend/config/settings.py、backend/services/prediction_store.py
FINSIGHT_CONFIG_DIR=
# 消费方：backend/agent_runtime/limits.py、backend/config/settings.py
FINSIGHT_RUNTIME_QUOTA_DB=
# 消费方：backend/agent_runtime/actions.py、backend/config/settings.py
FINSIGHT_ACTION_STORE=
# 消费方：backend/agent_runtime/data.py、backend/config/settings.py
FINSIGHT_ARTIFACT_DIR=

# ── features｜功能开关 ──

# 消费方：backend/config/settings.py、backend/services/startup_check.py
FINSIGHT_LLM_REQUIRED=false
# Local-only escape hatch for explicitly testing generation without login.
# 消费方：backend/api/security_gate.py、backend/config/settings.py
ALLOW_ANONYMOUS_GENERATION=false

# Evidence collector 合同。
# 消费方：backend/config/settings.py
RESEARCH_LEDGER_ENABLED=true
# 消费方：backend/graph/nodes/synthesize.py
QUERY_COVERAGE_ENABLED=true
# 消费方：backend/graph/planning/util.py
SEC_HOLDINGS_ENABLED=true

# Prediction 与页面 lease Monitor；无 PostgreSQL 时保持关闭。
# 消费方：backend/api/lifespan.py、backend/api/system_router.py 等
PREDICTION_GENERATION_ENABLED=false
# 消费方：backend/api/lifespan.py、backend/config/settings.py
PREDICTION_OUTCOME_SCHEDULER_ENABLED=false
# 消费方：backend/api/lifespan.py、backend/api/system_router.py 等
MONITOR_REALTIME_ENABLED=false
# 消费方：backend/rag/hybrid_service.py
RAG_V2_ALLOW_MEMORY_FALLBACK=true
# 消费方：backend/llm_config.py
ENABLE_LANGSMITH=false
# 消费方：backend/services/langfuse_tracer.py
LANGFUSE_ENABLED=false
# 消费方：backend/protocols/mcp_server.py
MCP_SERVER_ENABLED=false
# 消费方：backend/protocols/a2a_server.py
A2A_SERVER_ENABLED=false
# 消费方：backend/api/system_router.py、backend/config/settings.py 等
PREDICTION_ENABLED=false
# Enable only after checking image input on this exact model/endpoint.
# 消费方：backend/config/settings.py、backend/services/model_selection.py
FINSIGHT_AGENT_VISION=false

# ── auth｜认证、公开路径与CORS ──


# 认证与公开只读路径。production 必须 SUPABASE_AUTH_REQUIRED=true。
# 消费方：backend/config/settings.py
SUPABASE_AUTH_REQUIRED=false
# 消费方：backend/config/settings.py、backend/security/supabase_auth.py
SUPABASE_URL=
# 消费方：backend/api/security_gate.py、backend/config/settings.py 等
SUPABASE_JWT_SECRET=
# 消费方：backend/config/settings.py
SUPABASE_PUBLISHABLE_KEY=
# 消费方：backend/config/settings.py
API_PUBLIC_PATHS=/health,/livez,/readyz,/api/reports/shared/*
# 消费方：backend/config/settings.py
API_PUBLIC_READ_PATHS=/api/stock/price/*,/api/stock/news/*,/api/stock/kline/*,/api/dashboard/*
# 消费方：backend/api/app_factory.py
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 消费方：backend/api/app_factory.py
CORS_ALLOW_CREDENTIALS=false
# 消费方：backend/config/settings.py
VITE_SUPABASE_URL=
# 消费方：backend/config/settings.py
VITE_SUPABASE_PUBLISHABLE_KEY=
# 消费方：scripts/prediction_watchdog.py
SMTP_PASSWORD=
