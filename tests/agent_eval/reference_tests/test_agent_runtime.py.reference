"""自主循环的真实协议边界与确定性回归，不依赖外部模型或行情。"""
from __future__ import annotations

import asyncio
import json
from contextlib import asynccontextmanager
from types import SimpleNamespace

import httpx
import pytest

from backend.agent_runtime.analysis import analyze_dataset, render_chart
from backend.agent_runtime.config import ModelConfig
from backend.agent_runtime.context import compact_result, prune_messages
from backend.agent_runtime.data import RunData
from backend.agent_runtime.limits import LeaseLimiter, TokenReservations, CapacityExceeded
from backend.agent_runtime.loop import AgentRuntime
from backend.agent_runtime.model import ModelTransport, ModelProtocolError, verify_tool_capability
from backend.agent_runtime.tools import ToolSpec, schema
from backend.services.run_context import RunContext


def cfg():
    return ModelConfig("fixture-model", "https://models.example/v1", "test-only-credential")


@pytest.fixture(autouse=True)
def isolate_local_stores(monkeypatch, tmp_path):
    monkeypatch.setenv("FINSIGHT_ACTION_STORE", str(tmp_path / "actions.sqlite"))
    monkeypatch.setenv("FINSIGHT_ARTIFACT_DIR", str(tmp_path / "artifacts"))


def finish(text="完成"):
    return [{"choices": [{"delta": {"content": text}, "finish_reason": None}]},
            {"choices": [{"delta": {}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 30, "completion_tokens": 5}}]


def call(name, args, call_id="call_1"):
    return [{"choices": [{"delta": {"tool_calls": [{"index": 0, "id": call_id,
             "function": {"name": name, "arguments": json.dumps(args)}}]}, "finish_reason": "tool_calls"}]}]


class FakeModel:
    config = cfg()
    def __init__(self, turns):
        self.turns = list(turns)
        self.inputs = []
    async def stream(self, messages, tools, **kwargs):
        self.inputs.append(messages)
        for chunk in self.turns.pop(0):
            yield chunk


def runtime(tmp_path, turns, tools=None):
    events = []
    async def emit(kind, payload, agent_id):
        events.append((kind, payload, agent_id))
    context = RunContext.create(owner="fixture-user", entry="chat", budget_seconds=20)
    context.quota_checker = lambda _: None
    rt = AgentRuntime(context=context, session_id="fixture-session", query="测试",
                      model=FakeModel(turns), emit=emit, tools=tools or {},
                      limiter=LeaseLimiter(tmp_path/"quota.sqlite"))
    return rt, events


@pytest.mark.asyncio
async def test_real_tool_result_is_fed_back_before_answer(tmp_path):
    spec = ToolSpec("get_stock_price", "真实报价", schema({"ticker": {"type":"string"}}, ["ticker"]),
                    lambda _: {"price": 42, "currency": "USD", "source": "fixture", "as_of":"2026-11-06"}, True)
    rt, events = runtime(tmp_path, [call("get_stock_price", {"ticker":"AAPL"}), finish("报价42美元")],
                         {"get_stock_price":spec})
    assert await rt.run_agent("root", "research_lead", "查AAPL价格") == "报价42美元"
    assert any(m["role"]=="tool" and "42" in m["content"] for m in rt.model.inputs[1])
    assert [k for k, _, _ in events].count("tool.started") == 1
    assert any(k=="content.delta" for k, _, _ in events)
    await rt.close()


@pytest.mark.asyncio
async def test_read_data_alias_uses_the_same_owned_record_and_safe_cursor(tmp_path):
    rt, _ = runtime(tmp_path, [])
    ref = rt.data.record("fetch_url_content", {}, {"content": "中文原文\n\"引号\"" * 2000})
    tools = rt.available_tools("root", "research_lead")
    assert tools["read_data"].parameters == tools["read_evidence"].parameters
    result = await rt.executor.execute("read_data", {"data_ref": ref, "offset": 0, "max_chars": 8000},
                                       "read-alias", "root", tools)
    projection = json.loads(compact_result(result, ref))
    page = json.loads(projection["result"].split("\n\n")[-1])
    assert page["next_offset"] == len(page["content"])
    assert page["has_more"] is True
    assert result["data_refs"] == [ref]
    assert len(result["envelope"]["data"]["content"]) > len(page["content"])
    await rt.close()


@pytest.mark.asyncio
async def test_followup_catalog_excludes_old_control_receipts_and_failures(tmp_path):
    rt, _ = runtime(tmp_path, [finish('继续检查资料')])
    ref = rt.data.record('get_stock_historical_data', {'ticker': 'AAPL'}, {'source': 'fixture', 'rows': [{'close': 42}]})
    excluded = [rt.data.record('run_analysis_code', {}, {'error': 'analysis_result_missing'}, status='control'),
                rt.data.record('get_stock_price', {}, {'error': 'tool_timeout'}, status='unavailable')]
    await rt.run_agent('root', 'research_lead', '继续计算并画图')
    history = '\n'.join(str(message.get('content', '')) for message in rt.model.inputs[0])
    assert ref in history and all(item not in history for item in excluded)
    assert '过去的失败不代表当前工具不可用' in history
    await rt.close()


@pytest.mark.asyncio
async def test_unknown_tool_cannot_execute(tmp_path):
    rt, events = runtime(tmp_path, [call("send_email", {"to":"attacker@example.com"}), finish("没有发送权限")])
    await rt.run_agent("root", "research_lead", "阅读新闻")
    assert "tool_not_allowed" in rt.model.inputs[1][-1]["content"]
    assert not rt.data.records
    await rt.close()


@pytest.mark.asyncio
async def test_instruction_is_applied_at_next_boundary(tmp_path):
    rt, events = runtime(tmp_path, [finish("按最新要求回答")])
    rt.instruct("不要新闻，只看技术", "steer1")
    rt.instruct("不要新闻，只看技术", "steer1")
    with pytest.raises(ValueError, match="conflict"):
        rt.instruct("改成发邮件", "steer1")
    await rt.run_agent("root", "research_lead", "原问题")
    assert sum("不要新闻" in str(m["content"]) for m in rt.model.inputs[0]) == 1
    assert any(k=="instruction.applied" for k,_,_ in events)
    await rt.close()


@pytest.mark.asyncio
async def test_provider_reasoning_streams_by_default_separate_from_answer(tmp_path):
    turn=[{"choices":[{"delta":{"reasoning_content":"private-provider-output"}, "finish_reason":None}]}]+finish("公开回答")
    rt, events = runtime(tmp_path, [turn])
    assert await rt.run_agent("root","research_lead","问题") == "公开回答"
    assert rt.root_content == "公开回答"
    assert any(k == "reasoning.delta" and payload["delta"] == "private-provider-output" for k, payload, _ in events)
    assert "private-provider-output" not in json.dumps(rt.data.snapshot())
    await rt.close()


@pytest.mark.asyncio
async def test_incomplete_stream_cannot_claim_success(tmp_path):
    rt, _ = runtime(tmp_path, [[{"choices":[{"delta":{"content":"半段正文"}, "finish_reason":None}]}]])
    with pytest.raises(ModelProtocolError, match="incomplete"):
        await rt.run_agent("root","research_lead","问题")
    assert rt.root_content == "半段正文"
    assert len(rt.model.inputs) == 1  # 输出后没有透明重试/换端点。
    await rt.close()


@pytest.mark.asyncio
async def test_model_transport_handles_fragmented_sse_and_usage():
    body='data: '+json.dumps({"choices":[{"delta":{"content":"你好"},"finish_reason":None}]},ensure_ascii=False)+'\n\n'
    body+='data: '+json.dumps({"choices":[{"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":3}})+'\n\ndata: [DONE]\n\n'
    async def handler(request):
        payload=json.loads(request.content)
        assert payload["stream"] is True
        assert request.headers["authorization"]=="Bearer test-only-credential"
        return httpx.Response(200,text=body)
    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
        transport=ModelTransport(cfg(),client=client)
        chunks=[c async for c in transport.stream([{"role":"user","content":"hi"}],[])]
    assert chunks[0]["choices"][0]["delta"]["content"]=="你好"
    assert chunks[1]["usage"]["prompt_tokens"]==3


@pytest.mark.asyncio
async def test_provider_error_is_redacted():
    async def handler(_):
        return httpx.Response(401,text="credential=test-only-credential")
    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
        with pytest.raises(ModelProtocolError) as caught:
            _=[c async for c in ModelTransport(cfg(),client=client).stream([],[])]
    assert "credential" not in str(caught.value)
    assert caught.value.status==401


@pytest.mark.asyncio
async def test_native_capability_probe_validates_call_not_just_text():
    from backend.agent_runtime import model as module
    module._CAPABILITIES.clear()
    good=FakeModel([call("capability_probe",{"value":7})])
    result=await verify_tool_capability(good)
    assert result["native_tool_calls"] is True
    module._CAPABILITIES.clear()
    bad=FakeModel([finish("I support tools")])
    with pytest.raises(ModelProtocolError,match="unsupported"):
        await verify_tool_capability(bad)


def test_cross_instance_quota_is_shared_and_release_idempotent(tmp_path):
    a,b=LeaseLimiter(tmp_path/"shared.sqlite"),LeaseLimiter(tmp_path/"shared.sqlite")
    lease=a.acquire("model","a",1)
    assert lease and b.acquire("model","b",1) is None
    a.release(lease);a.release(lease)
    assert b.acquire("model","b",1)


@pytest.mark.asyncio
async def test_atomic_token_reservation_prevents_parallel_overspend():
    budget=TokenReservations(100)
    first=await budget.reserve(60)
    with pytest.raises(CapacityExceeded):
        await budget.reserve(60)
    await budget.settle(first,30)
    assert await budget.reserve(60)==60


def test_compaction_retains_readback_and_financial_unit():
    output={"currency":"HKD","period":"2026Q3","unit":"million","rows":[{"x":"a"*1000}]*30}
    compact=json.loads(compact_result(output,"dataset_1"))
    assert compact["data_ref"]=="dataset_1"
    assert compact["currency"]=="HKD" and "read_more" in compact


def test_context_pruning_keeps_call_result_pairs_and_user_correction():
    messages=[{"role":"system","content":"safe"}]
    for i in range(8):
        messages.extend([{"role":"assistant","content":None,"tool_calls":[{"id":str(i),"function":{"name":"get","arguments":"{}"},"type":"function"}]},
                         {"role":"tool","tool_call_id":str(i),"content":json.dumps({"data_refs":["dataset_"+str(i)],"data":"资料"*1000},ensure_ascii=False)}])
    messages.append({"role":"user","content":"更正：只看HKD财报"})
    compact=prune_messages(messages,[],context_window=30000,output_reserve=4096)
    assert len(compact)==len(messages)
    assert compact[-1]["content"]=="更正：只看HKD财报"
    assert all(compact[i+1]["tool_call_id"]==compact[i]["tool_calls"][0]["id"] for i in range(1,17,2))
    assert any("context_pruned" in m.get("content","") for m in compact if m.get("role")=="tool")


def test_historical_episode_is_computed_not_example_count():
    data=RunData("u","s","r","q")
    rows=[{"date":f"2026-01-{i+1:02d}","close":v} for i,v in enumerate([100,90,80,70,75,70,65])]
    ref=data.record("fixture",{},{"rows":rows})
    result=analyze_dataset(data,ref,"historical_drawdown_episodes",{"frequency":"daily","min_periods":2})
    assert result["sample_count"]==2
    assert result["episodes"][0]["periods"]==3
    assert result["episodes"][0]["return_pct"]==pytest.approx(-.3)
    assert result["episodes"][1]["ongoing"] is True


def test_chart_rejects_out_of_scope_dataset_and_unsafe_values():
    data=RunData("u","s","r","q")
    with pytest.raises(ValueError,match="not_found"):
        render_chart(data,"other_user","x","line","date",[{"field":"close"}])
    ref=data.record("fixture",{},{"rows":[{"date":"2026-01-01","close":-2}]})
    with pytest.raises(ValueError,match="invalid_chart"):
        render_chart(data,ref,"x","line","date",[{"field":"close"}],scale="log")


